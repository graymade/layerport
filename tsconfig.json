{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", "node_modules/@figma"]
  },
  "include": ["src/**/*.ts"]
}
